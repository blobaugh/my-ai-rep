# Directory of facts and qa markdown. Default content.
# A checkout with no private files can use the fictional samples:
# CONTENT_DIR=examples
# Real files are {name}.md. Samples are {name}.example.md.
# Facts: about.md, or about-ben.md if that is the file you already have.

# Who this checkout speaks for. The prompt file can add more.
BOT_NAME=Bot
HUMAN_NAME=
# Optional words the guardrail eval may flag. Empty stays quiet.
# TOPIC_LEAK_WORDS=

# LLM (src/chat.py)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
# Stock model. For a larger context, create one from the Modelfile and set that name.
LLM_MODEL=llama3.1:8b
# LLM_TEMPERATURE=0
LLM_MAX_TOKENS=600

# Chat / retrieval prompt assembly (BENBOT-6)
HISTORY_TURNS=6
# auto = the new message alone, plus the previous user message when it is a
# follow-up. turns = join the last RETRIEVAL_QUERY_TURNS user messages.
RETRIEVAL_QUERY_MODE=auto
# Used only when RETRIEVAL_QUERY_MODE=turns.
RETRIEVAL_QUERY_TURNS=2
# Prompt token budget (chars/4 heuristic). Derived from measured context
# minus max_tokens and a safety margin — see docs/decisions/008.
# With a Modelfile model (num_ctx 8192): ~7000. Stock llama3.1:8b is ~2048 — too small.
CONTEXT_BUDGET_TOKENS=7000
# Optional cosine floor; unset = send all retrieved chunks (threshold TBD).
# RETRIEVAL_MIN_SCORE=
# full = the whole facts file in the system prompt. summary = opening
# paragraph only. Default full. Do not change this without a measurement.
FACTS_IN_PROMPT=full
# RETRIEVAL_K=4
# RETRIEVAL_MAX_PER_ARTICLE=2
# retrieve = pull matching Q&A into the user message; stuff = put all Q&A in system.
QA_MODE=retrieve
# How Q&A and facts entries are embedded: question_and_answer, question_only,
# or multi (one vector per phrasing plus the question-and-answer vector).
# See docs/decisions/011 and docs/decisions/013-multi-vector-qa.md.
QA_EMBED_MODE=multi
# Optional few-shot voice samples in the system prompt (on|off). Default off.
VOICE_SAMPLES=off

# Embeddings (src/embeddings.py) — EMBED_BASE_URL / EMBED_API_KEY fall back to LLM_*
EMBED_MODEL=nomic-embed-text
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_BATCH_SIZE=32
EMBED_MAX_CHARS=8000
# nomic-embed-text task prefixes (chosen via eval compare — see docs/decisions/005)
# Quote so trailing spaces survive dotenv parsing.
EMBED_QUERY_PREFIX="search_query: "
EMBED_DOC_PREFIX="search_document: "

# LOG_LEVEL=WARNING
# LOG_TURNS=off
# Sentences kept when a draft is pruned. A shorter draft may keep one.
# VERIFY_PRUNE_MIN_SENTENCES=2
