# --- Docker Compose (production droplet or scripts/dev-up.sh) ---
# Fixed compose project name is "benbot" (see docker-compose.yml).
# BENBOT_HOME=.
# Host directory bind-mounted to /app/data (api) and /content or examples (dev).
# BENBOT_IMAGE_PREFIX=registry.example.com/benbot
# BENBOT_TAG=latest
# External network Nginx Proxy Manager uses (confirm with: docker network ls).
# PROXY_NETWORK=proxy
# Dev only: web proxies /api when set to 1 (docker-compose.dev.yml sets this).
# DEV_PROXY_API=0
# Bind address for python -m src.api (containers use 0.0.0.0:8000).
# API_HOST=127.0.0.1
# API_PORT=8000

# Directory of markdown. Default content.
# In compose prod: mount host content/ at /content and set CONTENT_DIR=/content.
# Dev compose mounts examples/ at /content automatically.
# A checkout with no private files can use the fictional samples:
# CONTENT_DIR=examples
# content/about.md is sent on every turn. Every other markdown file is searched.

# Who this checkout speaks for. The prompt file can add more.
BOT_NAME=Bot
HUMAN_NAME=
# Optional words the guardrail eval may flag. Empty stays quiet.
# TOPIC_LEAK_WORDS=

# LLM (src/chat.py). These three are the primary connection when LLM_PRIMARY_* is unset.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
# Stock model. For a larger context, create one from the Modelfile and set that name.
LLM_MODEL=llama3.1:8b
# Optional named connections. Set all three of a group, or leave the group blank.
# Blank means unset. A total timeout of 120s leaves room for a cold local model
# (about 18s to the first token, then generation). Connect timeout is 5s.
# LLM_PRIMARY_BASE_URL=
# LLM_PRIMARY_API_KEY=
# LLM_PRIMARY_MODEL=
# LLM_PRIMARY_TIMEOUT_SECONDS=120
# LLM_SECONDARY_BASE_URL=https://openrouter.ai/api/v1
# LLM_SECONDARY_API_KEY=
# LLM_SECONDARY_MODEL=openai/gpt-4o-mini
# Eval pick (2026-11-03, BENBOT-31): openai/gpt-4o-mini — re-run python -m eval.compare_models before changing.
# LLM_SECONDARY_TIMEOUT_SECONDS=120
# After a failover, wait this many seconds before trying the primary again.
# FAILOVER_RETRY_SECONDS=300
# Extra HTTP statuses that fail over. 429 and every 5xx already fail over.
# FAILOVER_ON_HTTP_STATUS=
# LLM_TEMPERATURE=0
LLM_MAX_TOKENS=600

# Chat / retrieval prompt assembly (BENBOT-6)
HISTORY_TURNS=6
# auto = the new message alone, plus the previous user message when it is a
# follow-up. turns = join the last RETRIEVAL_QUERY_TURNS user messages.
RETRIEVAL_QUERY_MODE=auto
# Used only when RETRIEVAL_QUERY_MODE=turns.
RETRIEVAL_QUERY_TURNS=2
# Prompt token budget (chars/4 heuristic). Derived from measured context
# minus max_tokens and a safety margin — see docs/decisions/008.
# With a Modelfile model (num_ctx 8192): ~7000. Stock llama3.1:8b is ~2048 — too small.
CONTEXT_BUDGET_TOKENS=7000
# Optional cosine floor; unset = send all retrieved chunks (threshold TBD).
# RETRIEVAL_MIN_SCORE=
# Optional floor for the weak_retrieval flag. Unset disables the flag.
# Scores are similarities, not probabilities. Leave unset unless answerable
# questions and gap questions separate cleanly on the current embedder.
# WEAK_RETRIEVAL_SCORE=
# RETRIEVAL_K=4
# RETRIEVAL_MAX_PER_ARTICLE=2
# How optional Q&A entries are embedded: question_and_answer, question_only,
# or multi (one vector per phrasing plus the question-and-answer vector).
# See docs/decisions/011 and docs/decisions/013-multi-vector-qa.md.
QA_EMBED_MODE=multi
# Optional few-shot voice samples in the system prompt (on|off). Default off.
VOICE_SAMPLES=off

# Embeddings (src/embeddings.py) — EMBED_BASE_URL / EMBED_API_KEY fall back to LLM_*
EMBED_MODEL=nomic-embed-text
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_BATCH_SIZE=32
EMBED_MAX_CHARS=8000
# nomic-embed-text task prefixes (chosen via eval compare — see docs/decisions/005)
# Quote so trailing spaces survive dotenv parsing.
EMBED_QUERY_PREFIX="search_query: "
EMBED_DOC_PREFIX="search_document: "

# SQLite exchange log. Visitor text is stored as typed. No IP or user agent.
# SESSION_MAX_MESSAGES counts visitor messages accepted into one session.
DB_PATH=data/benbot.sqlite
SESSION_IDLE_MINUTES=60
SESSION_MAX_MESSAGES=50
# Visitor message length for the HTTP API. The pipeline still refuses 2000.
MESSAGE_MAX_CHARS=1000
# In-flight pipeline cap and global UTC-day cap (0 disables daily cap).
# MAX_CONCURRENT_TURNS=2
# DAILY_MESSAGE_CAP=300
# BUSY_WAIT_SECONDS=3
# Comma-separated browser origins. Blank keeps CORS off. Never use *.
# CORS_ALLOWED_ORIGINS=
# CONTACT_URL=
# Optional replacements for the generated label, opening, and logging notice.
# AI_LABEL=
# OPENING_MESSAGE=
# LOGGING_NOTICE=
# Origins allowed to frame /embed. Blank uses web/frame_ancestors.default
# (comments only) or, if that file is empty, http://127.0.0.1:8080 and http://localhost:8080
# so the Docker web image still starts. Set explicit https origins in production.
# FRAME_ANCESTORS=

# Hourly SQLite snapshots to DigitalOcean Spaces (benbot_backup container).
# BACKUP_INTERVAL_MINUTES=60
# SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
# SPACES_BUCKET=your-private-bucket
# SPACES_PREFIX=benbot/prod
# SPACES_KEY=
# SPACES_SECRET=
# SPACES_REGION=nyc3
# SPACES_ADDRESSING_STYLE=auto
# Optional dead-man's-switch GET after each successful upload (not on failure).
# BACKUP_PING_URL=
# Daily tar of content/ at midnight UTC when on (private bucket only).
# BACKUP_CONTENT=off

# LOG_LEVEL=WARNING
# LOG_TURNS=off
# Sentences kept when a draft is pruned. A shorter draft may keep one.
# VERIFY_PRUNE_MIN_SENTENCES=2
